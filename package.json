    ".env.example"
  ],
  "engines": {
    "node": ">=22"
  },
  "private": "true",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrueLayer/truelayer_mcp.git"
  },
  "homepage": "https://github.com/TrueLayer/truelayer_mcp#readme",
  "bugs": {
    "url": "https://github.com/TrueLayer/truelayer_mcp/issues"
  }
}
