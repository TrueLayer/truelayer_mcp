{
  "name": "truelayer-mcp",
  "version": "1.0.0",
  "description": "Experimental MCP server exposing TrueLayer payments, payment links, payouts and merchant accounts to AI assistants",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "truelayer",
    "open-banking"
  ],
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "truelayer-signing": "^0.2.3",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22.13.14",
    "typescript": "^5.8.2"
  },
  "type": "module",
  "bin": {
    "truelayer-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "lint": "biome check .",
    "fix": "biome check --write ."
  },
  "files": [
