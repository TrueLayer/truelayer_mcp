# TrueLayer MCP configuration. Copy to .env (next to package.json) and fill in.
# Variables already set in the environment (e.g. an MCP client's "env" block)
# override this file. To keep the file elsewhere, set TRUELAYER_ENV_FILE.

# "sandbox" (default) or "production"
TRUELAYER_ENV=sandbox

# Console > Settings > API keys
TRUELAYER_CLIENT_ID=
# Set the secret inline, or point to a file containing only the secret
TRUELAYER_CLIENT_SECRET=
# TRUELAYER_CLIENT_SECRET_FILE=~/.config/truelayer-mcp/client-secret.txt

# Console > Settings > Payments > Signing keys: the key ID (KID) of the
# uploaded public key, and the matching EC P-521 private key
TRUELAYER_KID=
TRUELAYER_PRIVATE_KEY_FILE=~/.config/truelayer-mcp/ec512-private.pem
# or inline, with literal \n line breaks:
# TRUELAYER_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# Default merchant account for the tools
TRUELAYER_MERCHANT_ACCOUNT_ID=

# Token scopes. "paydirect" is needed for payouts; if Payouts isn't enabled on
# your client the token request fails with invalid_scope, so use "payments".
# TRUELAYER_TOKEN_SCOPE=paydirect payments
